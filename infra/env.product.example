# Plantilla del stack de producto. No pongas secretos reales en este archivo.
# `scripts/stack.ps1` crea `.env.product` (ignorado por git) con valores aleatorios.

RAG_ENVIRONMENT=production
RAG_LOG_LEVEL=INFO
RAG_POSTGRES_USER=engine_rag
RAG_POSTGRES_PASSWORD=reemplazar-con-un-secreto-aleatorio
RAG_POSTGRES_DB=engine_rag
RAG_JWT_SECRET=reemplazar-con-un-secreto-aleatorio-de-32-bytes
RAG_JWT_ISSUER=engine-rag
RAG_JWT_AUDIENCE=engine-rag-api
RAG_PSEUDONYM_SECRET=reemplazar-con-otro-secreto-aleatorio-de-32-bytes
RAG_CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
RAG_PUBLIC_HTTPS=false
RAG_REFRESH_COOKIE_SECURE=true
RAG_OLLAMA_BASE_URL=http://host.docker.internal:11434
RAG_GATEWAY_PORT=8080
ENGINE_RAG_VERSION=0.1.0
ENGINE_RAG_REVISION=dev
# El backup usa el volumen /backups. scripts/stack.ps1 crea .restic-password
# si no existe. Ese archivo no se versiona y no se imprime.
