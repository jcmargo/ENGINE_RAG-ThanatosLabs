RAG_ENVIRONMENT=development
RAG_LOG_LEVEL=INFO
RAG_API_HOST=127.0.0.1
RAG_API_PORT=8000
RAG_EMBEDDING_MODEL=intfloat/multilingual-e5-base
# Caché local del modelo. Si se omite, se usa la caché de Hugging Face del usuario.
# RAG_MODEL_CACHE_DIR=models/embeddings
RAG_LLM_MODEL=qwen2.5:7b
RAG_OLLAMA_BASE_URL=http://127.0.0.1:11434
RAG_LLM_TEMPERATURE=0
RAG_LLM_CONNECT_TIMEOUT_SECONDS=5
RAG_LLM_TIMEOUT_SECONDS=120
RAG_POSTGRES_USER=engine_rag
RAG_POSTGRES_PASSWORD=engine_rag_local
RAG_POSTGRES_DB=engine_rag
RAG_DATABASE_URL=postgresql+asyncpg://engine_rag:engine_rag_local@127.0.0.1:5432/engine_rag
RAG_QDRANT_URL=http://127.0.0.1:6333
# Separa las preguntas de data/sample de preguntas fuera de dominio.
RAG_MIN_RETRIEVAL_SCORE=0.8
# Solo para desarrollo/test local. En producción usa un secreto distinto de al menos 32 bytes.
RAG_JWT_SECRET=local-dev-only-jwt-secret-min-32b!
RAG_JWT_ISSUER=engine-rag
RAG_JWT_AUDIENCE=engine-rag-api
RAG_ACCESS_TOKEN_MINUTES=15
RAG_REFRESH_TOKEN_DAYS=7
RAG_REFRESH_COOKIE_NAME=rag_refresh
