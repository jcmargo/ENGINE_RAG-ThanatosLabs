RAG_ENVIRONMENT=development
RAG_LOG_LEVEL=INFO
RAG_API_HOST=127.0.0.1
RAG_API_PORT=8000
RAG_EMBEDDING_MODEL=intfloat/multilingual-e5-base
# `python -m app` carga este modelo antes de aceptar preguntas.
# Para omitirlo en esa arrancada: RAG_WARM_EMBEDDINGS=false
# Caché local del modelo. Si se omite, se usa la caché de Hugging Face del usuario.
# RAG_MODEL_CACHE_DIR=models/embeddings
RAG_LLM_MODEL=qwen2.5:7b
# Solo ollama. Otro valor impide el arranque. La API externa es opcional y va aparte.
RAG_LLM_PROVIDER=ollama
# API compatible con OpenAI. Si falta cualquiera, el selector no la ofrece.
# La clave no se escribe en logs, historial ni respuestas.
# RAG_EXTERNAL_LLM_BASE_URL=https://api.example.com/v1
# RAG_EXTERNAL_LLM_API_KEY=
# RAG_EXTERNAL_LLM_MODEL=
RAG_OLLAMA_BASE_URL=http://127.0.0.1:11434
RAG_LLM_TEMPERATURE=0
RAG_LLM_CONNECT_TIMEOUT_SECONDS=5
RAG_LLM_TIMEOUT_SECONDS=120
RAG_POSTGRES_USER=engine_rag
# Solo para desarrollo local. No uses este password fuera de loopback.
# RAG_DATABASE_URL debe llevar el mismo password que RAG_POSTGRES_PASSWORD (Compose).
RAG_POSTGRES_PASSWORD=engine_rag_local
RAG_POSTGRES_DB=engine_rag
RAG_DATABASE_URL=postgresql+asyncpg://engine_rag:engine_rag_local@127.0.0.1:5432/engine_rag
RAG_QDRANT_URL=http://127.0.0.1:6333
# Corte más alto que aún acepta los tres hechos de data/sample.
RAG_MIN_RETRIEVAL_SCORE=0.857
# Entre este piso y el de coseno, el fragmento debe cubrir al menos la mitad de las palabras.
RAG_MIN_LEXICAL_SCORE=0.80
# Máximo de la pregunta ya normalizada. El texto no se registra.
RAG_MAX_QUESTION_CHARS=2000
# Tope de caracteres de contexto enviados al modelo, sobre copias. No altera el original.
RAG_MAX_CONTEXT_CHARS=12000
# Vencimiento lógico. El borrado físico llega en una spec posterior.
RAG_CONVERSATION_RETENTION_DAYS=30
RAG_TRACE_RETENTION_DAYS=90
RAG_FEEDBACK_REASON_MAX_CHARS=500
# Solo para desarrollo/test local. En producción usa un secreto distinto de al menos 32 bytes.
RAG_JWT_SECRET=local-dev-only-jwt-secret-min-32b!
RAG_JWT_ISSUER=engine-rag
RAG_JWT_AUDIENCE=engine-rag-api
RAG_ACCESS_TOKEN_MINUTES=15
RAG_REFRESH_TOKEN_DAYS=7
RAG_REFRESH_COOKIE_NAME=rag_refresh
RAG_FILE_STORE_PATH=data/uploads
RAG_MAX_UPLOAD_BYTES=26214400
RAG_MAX_DOCUMENTS_PER_TENANT=500
RAG_MAX_STORAGE_BYTES_PER_TENANT=2147483648
RAG_WORKER_POLL_SECONDS=1
RAG_WORKER_LEASE_SECONDS=60
RAG_WORKER_HEARTBEAT_SECONDS=15
RAG_WORKER_MAX_ATTEMPTS=5
RAG_WORKER_BACKOFF_BASE_SECONDS=2
RAG_WORKER_BACKOFF_CAP_SECONDS=300
RAG_EMBED_BATCH_SIZE=16
RAG_INDEX_REVISION=v1
RAG_VECTOR_ALIAS=engine_rag_active
# HMAC de logs y rate limit. En producción usa un secreto propio de al menos 32 bytes.
RAG_PSEUDONYM_SECRET=local-dev-only-pseudonym-secret-32b
# Allowlist explícita. No uses * junto con cookies.
RAG_CORS_ORIGINS=http://localhost:5173
RAG_METRICS_ALLOW_CIDRS=127.0.0.1/32,::1/128
# HSTS solo cuando el dominio público ya responde por HTTPS.
RAG_PUBLIC_HTTPS=false
RAG_REFRESH_COOKIE_SECURE=false
RAG_CSRF_COOKIE_NAME=rag_csrf
RAG_AUDIT_RETENTION_DAYS=90
RAG_RATE_LOGIN_LIMIT=30
RAG_RATE_LOGIN_WINDOW_SECONDS=60
RAG_RATE_REFRESH_LIMIT=60
RAG_RATE_REFRESH_WINDOW_SECONDS=60
RAG_RATE_QUESTIONS_LIMIT=60
RAG_RATE_QUESTIONS_WINDOW_SECONDS=60
RAG_RATE_UPLOADS_LIMIT=30
RAG_RATE_UPLOADS_WINDOW_SECONDS=60
RAG_RATE_ADMIN_LIMIT=120
RAG_RATE_ADMIN_WINDOW_SECONDS=60
